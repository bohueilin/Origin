{
  "name": "@origin/origin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/main.ts",
    "foundry": "bash foundry.sh",
    "verify:evidence": "node scripts/verifyServerEvidence.mjs",
    "proof:generate": "node scripts/generate-tr-a002.mjs",
    "proof:verify": "node scripts/verify-tr-a002.mjs",
    "env:generate": "node scripts/gen-env-evidence.mjs",
    "env:verify": "node scripts/env-verify.mjs",
    "env:rollout": "node scripts/env-rollout.mjs",
    "env:run": "node scripts/env-run.mjs",
    "env:dispute": "node scripts/env-verify.mjs --dispute",
    "env:checkpoint": "node scripts/gen-checkpoint-evidence.mjs",
    "curriculum:generate": "node scripts/gen-curriculum.mjs",
    "curriculum:verify": "node scripts/curriculum-verify.mjs",
    "env:promote": "node scripts/env-promote.mjs",
    "reward:diff": "node scripts/reward-diff.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "og:generate": "node scripts/generate-og-card.mjs",
    "og:cards": "node scripts/og-cards.mjs",
    "og:cards:check": "node scripts/og-cards.mjs --check",
    "gates": "npm run build && npm run lint && npm run verify:evidence && npm run proof:verify && npm run reward:diff && npm test && npm run reachability && npm run css:version && npm run bench:gate:check && npm run bench:fleet:check && npm run bench:overgrant:check && npm run og:cards:check",
    "bench:gate": "node scripts/floor-gate-bench.mjs",
    "bench:gate:check": "node scripts/floor-gate-bench.mjs --check",
    "bench:perceiver": "node scripts/perceiver-bench.mjs",
    "bench:fleet": "node scripts/fleet-bench.mjs",
    "bench:fleet:check": "node scripts/fleet-bench.mjs --check",
    "bench:overgrant": "node scripts/overgrant-bench.mjs",
    "bench:overgrant:check": "node scripts/overgrant-bench.mjs --check",
    "gates:full": "npm run gates && npm run test:e2e",
    "reachability": "node scripts/reachability-lint.mjs --max 13",
    "css:version": "node scripts/css-version-lint.mjs",
    "css:version:fix": "node scripts/css-version-lint.mjs --fix"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@insforge/sdk": "^1.5.2",
    "@origin/evidence": "*",
    "@origin/verifier-core": "*",
    "hono": "^4.13.5",
    "openai": "^6.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "viem": "^2.56.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
