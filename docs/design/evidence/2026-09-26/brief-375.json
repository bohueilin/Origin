4.5,"disabled":false,"unresolved":false},{"selector":"p.kicker","text":"THE EVIDENCE LAYER FOR AI AGENTS","color":"rgb(43, 82, 59)","background":[248,247,244],"ratio":8.261,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"h1","text":"A reference check before the right to act.","color":"rgb(39, 45, 38)","background":[248,247,244],"ratio":13.159,"minimum":3,"disabled":false,"unresolved":false},{"selector":"p.brief__lede","text":"Origin binds an agent configuration, challenges a policy with deterministic synthetic tasks, and produces a tamper-evident evidence artifact a reviewer can recheck.","color":"rgb(78, 91, 72)","background":[248,247,244],"ratio":6.727,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"p.brief__boundary","text":"The public demo is browser-local, synthetic, session-signed, and unpinned. Execution is not attempted. Not production SaaS or compliance certification.","color":"rgb(89, 102, 79)","background":[248,247,244],"ratio":5.701,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"span","text":"01","color":"rgb(89, 102, 79)","background":[237,241,231],"ratio":5.333,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"h2","text":"Bind","color":"rgb(39, 45, 38)","background":[237,241,231],"ratio":12.31,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"p","text":"Record the model, tools, policy, budget, and scenario battery.","color":"rgb(78, 91, 72)","background":[237,241,231],"ratio":6.293,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"span","text":"02","color":"rgb(89, 102, 79)","background":[237,241,231],"ratio":5.333,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"h2","text":"Challenge","color":"rgb(39, 45, 38)","background":[237,241,231],"ratio":12.31,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"p","text":"Exercise the policy against a synthetic task battery.","color":"rgb(78, 91, 72)","background":[237,241,231],"ratio":6.293,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"span","text":"03","color":"rgb(89, 102, 79)","background":[237,241,231],"ratio":5.333,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"h2","text":"Grade","color":"rgb(39, 45, 38)","background":[237,241,231],"ratio":12.31,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"p","text":"A deterministic oracle evaluates the decisions.","color":"rgb(78, 91, 72)","background":[237,241,231],"ratio":6.293,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"span","text":"04","color":"rgb(89, 102, 79)","background":[237,241,231],"ratio":5.333,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"h2","text":"Attest","color":"rgb(39, 45, 38)","background":[237,241,231],"ratio":12.31,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"p","text":"Seal the result and configuration in a demo artifact.","color":"rgb(78, 91, 72)","background":[237,241,231],"ratio":6.293,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"span","text":"05","color":"rgb(89, 102, 79)","background":[237,241,231],"ratio":5.333,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"h2","text":"Reverify","color":"rgb(39, 45, 38)","background":[237,241,231],"ratio":12.31,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"p","text":"Check the artifact offline. A changed bound field returns VOID.","color":"rgb(78, 91, 72)","background":[237,241,231],"ratio":6.293,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"h2","text":"For the team facing security review.","color":"rgb(39, 45, 38)","background":[248,247,244],"ratio":13.159,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"p","text":"Agent-platform, security, and infrastructure teams need to make a specific workflow reviewable: the permissions requested, the policy decisions observed, and the limits of the evid","color":"rgb(78, 91, 72)","background":[248,247,244],"ratio":6.727,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"p","text":"First wedge: internal-ops and production-access agent workflows. Capability alone does not establish permission.","color":"rgb(78, 91, 72)","background":[248,247,244],"ratio":6.727,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"b","text":"First wedge:","color":"rgb(78, 91, 72)","background":[248,247,244],"ratio":6.727,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"h2","text":"One artifact, explicit boundaries.","color":"rgb(39, 45, 38)","background":[248,247,244],"ratio":13.159,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"li","text":"The configuration and evaluation context are bound to the result.","color":"rgb(78, 91, 72)","background":[248,247,244],"ratio":6.727,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"li","text":"The deterministic oracle is the sole grading authority.","color":"rgb(78, 91, 72)","background":[248,247,244],"ratio":6.727,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"li","text":"Signature and digest checks establish integrity under their bindings; an unpinned demo signer does not establish trusted Origin issuance.","color":"rgb(78, 91, 72)","background":[248,247,244],"ratio":6.727,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"li","text":"A synthetic pass does not establish production readiness.","color":"rgb(78, 91, 72)","background":[248,247,244],"ratio":6.727,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"h2","text":"The evidence ladder.","color":"rgb(39, 45, 38)","background":[248,247,244],"ratio":13.159,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"b","text":"TR-A001","color":"rgb(39, 45, 38)","background":[248,247,244],"ratio":13.159,"minimum":4.5,"disabled":false,"unresolved":false},{"selector":"p","text":"Authored specimen \u2014 evidence-package format only.","color":"rgb(78, 91, 72)","background":[248,247,244],"ratio":6.