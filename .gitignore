# --- JS / TS ---
node_modules/
dist/
.turbo/
.wrangler/
*.tsbuildinfo

# --- Python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- external/heavy (regenerated by bootstrap scripts) ---
.external/

# --- secrets & local config (NEVER commit) ---
.env
.env.local
.env.*
!.env.example

# --- logs / editor / os ---
*.log
.DS_Store
.vscode/
.idea/

# --- big data (kept out of git or via LFS only) ---
datasets/**/*.RData
datasets/**/*.mp4

# --- private factory algorithm (crown-jewel IP: its own local repo, never in the public tree) ---
factory-private/
# Private-algorithm residue dirs — never track in the public repo (defense-in-depth beyond __pycache__/;
# CPVER audit #9: the deterministic-oracle bytecode must not sit one `git add -f` from a public commit).
services/factoryceo-trm/
services/foundry-train/
site-to-gym/

# InsForge CLI link state. `npx @insforge/cli link` writes .insforge/project.json,
# which contains the project's FULL-ACCESS ADMIN API key (ik_ prefix). This is a
# PUBLIC repo — that file must never be committed. The public anon_ key is a
# different value and belongs in the deploy workflow.
.insforge/

# Working strategy/design docs kept out of the public repo. These are the founder's
# planning material, not product source; one `git add -A` would publish them.
# Ignored rather than deleted so the move-to-private decision stays open.
docs/superpowers/
